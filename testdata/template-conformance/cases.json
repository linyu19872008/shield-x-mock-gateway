[
  {
    "id": "01-simple-replace",
    "description": "最基础的单占位符替换",
    "template": "<p>{{request_id}}</p>",
    "vars": { "request_id": "req-001" },
    "expected": "<p>req-001</p>"
  },
  {
    "id": "02-multi-placeholders",
    "description": "多个不同占位符混排，验证不会相互干扰",
    "template": "<title>{{site_name}}</title><p>{{client_ip}} 访问 {{path}} 时间 {{timestamp}}</p>",
    "vars": {
      "site_name": "示例站点",
      "client_ip": "203.0.113.66",
      "path": "/api/login",
      "timestamp": "2026-11-14T00:30:00+08:00"
    },
    "expected": "<title>示例站点</title><p>203.0.113.66 访问 /api/login 时间 2026-11-14T00:30:00+08:00</p>"
  },
  {
    "id": "03-escape-special-chars",
    "description": "五个特殊字符全部必须转义，防止模板注入与反射型 XSS",
    "template": "<p>{{host}}</p>",
    "vars": { "host": "<script>alert(\"x\")&'y'</script>" },
    "expected": "<p>&lt;script&gt;alert(&quot;x&quot;)&amp;&#39;y&#39;&lt;/script&gt;</p>"
  },
  {
    "id": "04-escape-amp-order",
    "description": "必须先把 & 转义，再把 < > 等转义。若顺序颠倒，&lt; 会被二次转义成 &amp;lt;",
    "template": "<i>{{site_name}}</i>",
    "vars": { "site_name": "a<b" },
    "expected": "<i>a&lt;b</i>"
  },
  {
    "id": "05-unknown-kept",
    "description": "不在白名单的占位符必须原样保留（含内部空白），不得删除也不得替换为空",
    "template": "<p>{{unknown_key}}</p><p>{{  another_key  }}</p>",
    "vars": {},
    "expected": "<p>{{unknown_key}}</p><p>{{  another_key  }}</p>"
  },
  {
    "id": "06-missing-var-empty",
    "description": "白名单占位符但变量缺失 → 替换为空串，不抛错",
    "template": "<p>[{{contact_email}}]</p>",
    "vars": { "site_name": "示例站点" },
    "expected": "<p>[]</p>"
  },
  {
    "id": "07-css-braces",
    "description": "内联 CSS 里的单层花括号不得被误判为占位符",
    "template": "<style>body{margin:0;padding:8px}.a::before{content:\"{}\"}.b{color:#333}</style><p>{{request_id}}</p>",
    "vars": { "request_id": "r-7" },
    "expected": "<style>body{margin:0;padding:8px}.a::before{content:\"{}\"}.b{color:#333}</style><p>r-7</p>"
  },
  {
    "id": "08-nested-braces",
    "description": "四层花括号：从左到右首次匹配到 {{request_id}} 即替换，外层残留的 {{ 与 }} 原样保留，且替换结果不被二次扫描",
    "template": "<p>{{{{request_id}}}}</p>",
    "vars": { "request_id": "r-8" },
    "expected": "<p>{{r-8}}</p>"
  },
  {
    "id": "09-unicode",
    "description": "中文、emoji、IPv6 字面量必须原样透传（IPv6 的冒号不转义）",
    "template": "<p>{{site_name}} · {{client_ip}}</p>",
    "vars": { "site_name": "半山垂钓 🎣", "client_ip": "2001:db8::1" },
    "expected": "<p>半山垂钓 🎣 · 2001:db8::1</p>"
  },
  {
    "id": "10-crlf-preserved",
    "description": "换行符原样保留，不得把 CRLF 统一成 LF",
    "template": "<p>a</p>\r\n<p>{{request_id}}</p>\r\n",
    "vars": { "request_id": "r-10" },
    "expected": "<p>a</p>\r\n<p>r-10</p>\r\n"
  },
  {
    "id": "11-bom-stripped",
    "description": "模板开头的 UTF-8 BOM（U+FEFF）必须剔除，不得出现在输出里",
    "template": "\uFEFF<p>{{request_id}}</p>",
    "vars": { "request_id": "r-11" },
    "expected": "<p>r-11</p>"
  },
  {
    "id": "12-too-large",
    "description": "模板超过 64 KiB 必须拒绝渲染（返回错误即视为通过，结果是兜底页）",
    "template_repeat": { "text": "<p>0123456789</p>", "times": 6000 },
    "vars": {},
    "expect_error": "TEMPLATE_TOO_LARGE"
  },
  {
    "id": "13-whitespace-in-placeholder",
    "description": "花括号内允许任意空白，{ { 之类不算；用逐 key 字符串替换的实现会在此失败",
    "template": "<p>{{   request_id   }}</p>",
    "vars": { "request_id": "r-13" },
    "expected": "<p>r-13</p>"
  },
  {
    "id": "14-uppercase-not-matched",
    "description": "占位符名只允许小写字母与下划线；大写名称不匹配，整段原样保留",
    "template": "<p>{{Request_ID}}</p>",
    "vars": { "request_id": "r-14" },
    "expected": "<p>{{Request_ID}}</p>"
  }
]
